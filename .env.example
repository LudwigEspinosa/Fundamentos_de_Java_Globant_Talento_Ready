# ==============================================================================
# NeonPulse Ticketing Platform - Environment Variables Template
# Copy this file to .env and configure values for your deployment environment.
# ==============================================================================

# Server Profile (dev / prod / test)
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# PostgreSQL Database Configuration
POSTGRES_DB=neonpulse_db
POSTGRES_USER=neonpulse_user
POSTGRES_PASSWORD=neonpulse_pass
DATABASE_URL=jdbc:postgresql://localhost:5432/neonpulse_db

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080/api/v1
